#!/bin/bash
# Re-assert the plugin's conveniences after `omarchy update`.
#
# v0.8: rendering is delegated to owe (a system daemon), so this hook no
# longer swaps background services or applies a Qt hwaccel drop-in. It only
# (re)deploys the self-contained video keybindings block and keeps the theme
# menu tidy. Both are idempotent and silent when already in place.

set -euo pipefail

PLUGIN_DIR="$HOME/.config/omarchy/plugins/io.github.p3lu.video-background"

[[ -x "$PLUGIN_DIR/bin/video-bindings.sh" ]] || exit 0
"$PLUGIN_DIR/bin/video-bindings.sh" --add --quiet || true
[[ -x "$PLUGIN_DIR/bin/video-menu.sh" ]] && "$PLUGIN_DIR/bin/video-menu.sh" --add --quiet || true

exit 0
